# Dépendances installées par npm — ne jamais versionner (des centaines de Mo)
node_modules/

# Sorties de build Astro — régénérées à chaque build, en local comme sur Netlify
dist/
.astro/

# Variables d'environnement (clés d'API, jetons) — ne jamais versionner
.env
.env.*
!.env.example

# Journaux npm
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Fichiers système macOS et éditeurs
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Dossier Netlify local
.netlify/
.claude/
