---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Pour ajouter un outil : créer sa page dans src/pages/outils/ puis ajouter une ligne ici.
const outils = [
  {
    href: '/outils/calculateur-automatisation',
    categorie: 'Calculateur',
    titre: 'Combien coûte ton automatisation sur Zapier, Make et n8n',
    description: "Entre ton volume et ton nombre d'étapes : le calcul trouve le palier le moins cher chez chacun des trois, avec des coefficients mesurés sur 50 déclenchements réels.",
  },
];
---
<BaseLayout
  title="Outils — Le Levier"
  description="Calculateurs et outils gratuits pour chiffrer tes choix d'outils avant de payer, construits à partir de tests réels."
>
  <div class="wrap" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="col" style="max-width: 1000px;">
      <span class="eyebrow">Le Levier</span>
      <h1>Outils</h1>
      <p class="lede">Des outils gratuits pour chiffrer tes choix avant de payer, construits à partir de mes tests réels.</p>
      <div class="card-grid">
        {outils.map((outil) => (
          <a class="card" href={outil.href}>
            <span class="eyebrow">{outil.categorie}</span>
            <h3>{outil.titre}</h3>
            <p>{outil.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .eyebrow { display: block; margin-bottom: 12px; }
  h1 { margin-bottom: 12px; }
  .lede { color: var(--ink-2); margin-bottom: 32px; }
  .card .eyebrow { margin-bottom: 2px; }
</style>
