---
/*
  Comparateur de coût Zapier / Make / n8n.

  Coefficients issus d'un test réel : 50 déclenchements par outil sur un même
  scénario à 4 étapes (Google Sheets -> HubSpot -> Gmail -> Slack).
  Grilles tarifaires relevées le 25/09/2026.

  POUR METTRE À JOUR LES PRIX : tout est dans l'objet LADDERS en haut du
  bloc de script ci-dessous. Format d'une ligne : [capacité, prix/mois en annuel,
  prix/mois en mensuel]. Rien d'autre à toucher. Pense à changer aussi la
  date affichée dans le bloc "provenance" et le taux USD si besoin.

  Utilisation dans un article .mdx :
    import ComparateurCout from '../../components/ComparateurCout.astro';
    <ComparateurCout />

  Sur une page dédiée où le H1 porte déjà le titre : <ComparateurCout intro={false} />
  masque le sur-titre, le titre et le chapeau (la ligne de provenance reste).
*/
interface Props {
  intro?: boolean;
}
const { intro = true } = Astro.props;
---

<div class="cmp">
  <div class="cmp-head">
    {intro && <>
    <p class="cmp-eyebrow">Calculateur</p>
    <h3 class="cmp-h3">Combien coûterait ton scénario</h3>
    <p class="cmp-lede">Décris ton automatisation : le calcul applique les coefficients mesurés sur mon test et cherche, pour chaque outil, le palier tarifaire le moins cher qui tient.</p>
    </>}
    <div class="cmp-prov">
      <span>Coefficients mesurés sur <b>50 déclenchements réels par outil</b></span>
      <span>Grilles relevées le <b>25/09/2026</b></span>
      <span>Make converti du dollar à <b>0,8743</b></span>
    </div>
  </div>

  <div class="cmp-layout">
    <form class="cmp-panel cmp-controls" id="cmpForm" autocomplete="off">
      <div class="cmp-field">
        <label for="cmpEvents">Déclenchements par mois</label>
        <input type="number" id="cmpEvents" min="1" max="200000" step="1" value="1000" />
        <input type="range" id="cmpEventsR" min="0" max="100" step="1" value="60" aria-label="Déclenchements par mois (curseur)" />
        <p class="cmp-hint">Le nombre de fois où le scénario doit s'exécuter : leads, commandes, factures, messages reçus.</p>
      </div>

      <div class="cmp-field">
        <label for="cmpActions">Actions facturables</label>
        <input type="number" id="cmpActions" min="1" max="30" step="1" value="3" />
        <p class="cmp-hint">Les étapes qui <em>font</em> quelque chose : créer une fiche, envoyer un email, poster un message, mettre à jour une ligne.</p>
      </div>

      <div class="cmp-field">
        <label for="cmpPlumb">Étapes de plomberie</label>
        <input type="number" id="cmpPlumb" min="0" max="30" step="1" value="0" />
        <p class="cmp-hint">Filtres, mise en forme, routage, délais. Zapier ne les facture pas, Make les compte comme n'importe quel module.</p>
      </div>

      <div class="cmp-field">
        <span class="cmp-label" id="cmpModeL">Mode de déclenchement</span>
        <div class="cmp-seg" role="group" aria-labelledby="cmpModeL">
          <button type="button" id="cmpPoll" aria-pressed="true">Interrogation</button>
          <button type="button" id="cmpHook" aria-pressed="false">Instantané</button>
        </div>
        <p class="cmp-hint" id="cmpModeHint"></p>
      </div>

      <div class="cmp-field" id="cmpIvField">
        <label for="cmpIv">Intervalle de vérification</label>
        <select id="cmpIv">
          <option value="1">Toutes les minutes</option>
          <option value="5">Toutes les 5 minutes</option>
          <option value="15" selected>Toutes les 15 minutes</option>
          <option value="60">Toutes les heures</option>
          <option value="360">Toutes les 6 heures</option>
          <option value="1440">Une fois par jour</option>
        </select>
        <p class="cmp-hint" id="cmpCyclesHint"></p>
      </div>

      <div class="cmp-field">
        <span class="cmp-label" id="cmpBillL">Engagement</span>
        <div class="cmp-seg" role="group" aria-labelledby="cmpBillL">
          <button type="button" id="cmpYear" aria-pressed="true">Annuel</button>
          <button type="button" id="cmpMonth" aria-pressed="false">Mensuel</button>
        </div>
        <p class="cmp-hint">Les trois outils affichent par défaut le tarif annuel, payé d'avance. Sans engagement, compte environ 20 % de plus.</p>
      </div>
    </form>

    <div class="cmp-results">
      <div class="cmp-verdict">
        <p class="cmp-vtitle" id="cmpVTitle"></p>
        <p id="cmpVBody"></p>
      </div>
      <div id="cmpTools"></div>
    </div>
  </div>

  <div class="cmp-panel cmp-chart">
    <div class="cmp-chartbar">
      <div class="cmp-legend">
        <span><i class="cmp-dot" style="--sc:var(--cmp-s1)"></i>Zapier</span>
        <span><i class="cmp-dot" style="--sc:var(--cmp-s2)"></i>Make</span>
        <span><i class="cmp-dot" style="--sc:var(--cmp-s3)"></i>n8n</span>
      </div>
      <button type="button" class="cmp-ghost" id="cmpTToggle" aria-expanded="false">Voir les valeurs</button>
    </div>
    <div class="cmp-plotwrap" id="cmpPlotwrap">
      <svg class="cmp-plot" id="cmpPlot" viewBox="0 0 760 340" role="img" aria-label="Coût mensuel en euros selon le nombre de déclenchements par mois, pour Zapier, Make et n8n"></svg>
      <div class="cmp-tip" id="cmpTip"></div>
    </div>
    <div class="cmp-tablewrap" id="cmpTWrap" hidden>
      <table class="cmp-table" id="cmpTbl">
        <thead><tr><th>Déclenchements/mois</th><th>Zapier</th><th>Make</th><th>n8n</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="cmp-caption">Chaque marche est un palier tarifaire : tant que le volume tient dans le palier, le prix ne bouge pas.</p>
  </div>
</div>

<style is:global>
  /* ---- Comparateur : tout est préfixé .cmp pour ne rien déborder ---- */
  .cmp {
    --cmp-s1: #2a78d6;
    --cmp-s2: #eb6834;
    --cmp-s3: #1baf7a;
    --cmp-grid: var(--rule);
    --cmp-shadow: 0 1px 2px rgba(21, 25, 27, .05), 0 8px 24px -18px rgba(21, 25, 27, .2);

    /* sortie de la colonne de lecture (68ch) sans dépasser la page */
    width: min(1000px, calc(100vw - 48px));
    margin-left: 50%;
    transform: translateX(-50%);
    margin-block: 40px;

    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (prefers-color-scheme: dark) {
    .cmp {
      --cmp-s1: #3987e5;
      --cmp-s2: #d95926;
      --cmp-s3: #199e70;
      --cmp-shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px -18px rgba(0, 0, 0, .7);
    }
  }

  /* neutralise les styles d'article à l'intérieur du composant */
  article.body-content .cmp p,
  article.body-content .cmp h2,
  article.body-content .cmp h3,
  article.body-content .cmp ul,
  article.body-content .cmp li { margin: 0; }
  article.body-content .cmp table { margin: 14px 0 0; font-size: 13px; font-family: var(--sans); }
  article.body-content .cmp th,
  article.body-content .cmp td {
    border: 0; border-bottom: 1px solid var(--rule);
    padding: 7px 10px; text-align: right; background: none;
  }
  article.body-content .cmp th:first-child,
  article.body-content .cmp td:first-child { text-align: left; }
  article.body-content .cmp thead th {
    font-family: var(--mono); font-size: 10.5px; letter-spacing: .07em;
    text-transform: uppercase; color: var(--ink-3); font-weight: 500;
  }
  article.body-content .cmp tbody td:not(:first-child) {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
  }

  .cmp-head { display: flex; flex-direction: column; gap: 8px; }
  .cmp-eyebrow {
    font-family: var(--mono); font-size: .68rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .cmp .cmp-h3 { font-size: 1.4rem; font-weight: 600; letter-spacing: -.015em; }
  .cmp-lede { color: var(--ink-2); font-size: 14.5px; max-width: 62ch; }
  .cmp-prov {
    display: flex; flex-wrap: wrap; gap: 4px 18px;
    padding-top: 10px; border-top: 1px solid var(--rule);
    font-family: var(--mono); font-size: 11px; color: var(--ink-3);
  }
  .cmp-prov b { color: var(--ink-2); font-weight: 500; }

  .cmp-layout { display: grid; grid-template-columns: 290px 1fr; gap: 20px; align-items: start; }
  @media (max-width: 760px) { .cmp-layout { grid-template-columns: 1fr; } }

  .cmp-panel {
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: 8px; padding: 18px; box-shadow: var(--cmp-shadow);
  }
  .cmp-controls { display: flex; flex-direction: column; gap: 18px; }
  .cmp-field { display: flex; flex-direction: column; gap: 6px; }
  .cmp-field > label, .cmp .cmp-label { font-size: 13px; font-weight: 600; color: var(--ink); }
  .cmp-hint { font-size: 11.5px; color: var(--ink-3); line-height: 1.4; }
  .cmp-hint em { font-style: italic; }

  .cmp input[type=number], .cmp select {
    font: inherit; font-size: 14px; color: var(--ink); background: var(--surface-2);
    border: 1px solid var(--rule); border-radius: 5px; padding: 8px 10px; width: 100%;
  }
  .cmp input[type=number] { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .cmp input[type=range] { width: 100%; accent-color: var(--accent); margin: 0; }
  .cmp :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .cmp-seg { display: flex; border: 1px solid var(--rule); border-radius: 5px; overflow: hidden; }
  .cmp-seg button {
    flex: 1; font: inherit; font-family: var(--sans); font-size: 12.5px; font-weight: 500;
    padding: 8px 6px; background: var(--surface-2); color: var(--ink-2); border: 0; cursor: pointer;
  }
  .cmp-seg button[aria-pressed=true] { background: var(--accent); color: var(--surface); }
  @media (prefers-color-scheme: dark) {
    .cmp-seg button[aria-pressed=true] { color: #111513; }
  }
  .cmp-seg button + button { border-left: 1px solid var(--rule); }

  .cmp-results { display: flex; flex-direction: column; gap: 12px; }
  .cmp-verdict {
    background: var(--accent-soft); border: 1px solid var(--rule);
    border-radius: 8px; padding: 15px 17px; display: flex; flex-direction: column; gap: 4px;
  }
  .cmp-vtitle { font-size: 16px; font-weight: 600; letter-spacing: -.01em; color: var(--ink); }
  .cmp-verdict p { font-size: 13.5px; color: var(--ink-2); }

  .cmp-tool {
    background: var(--surface); border: 1px solid var(--rule); border-left: 4px solid var(--sc);
    border-radius: 7px; padding: 14px 16px; display: grid; gap: 10px;
    grid-template-columns: 1fr auto; align-items: start; box-shadow: var(--cmp-shadow);
    margin-bottom: 12px;
  }
  .cmp-tool:last-child { margin-bottom: 0; }
  .cmp-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .cmp-name strong { font-size: 15.5px; font-weight: 600; }
  .cmp-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--sc); flex: none; display: inline-block; }
  .cmp-badge {
    font-family: var(--mono); font-size: 9.5px; font-weight: 500; letter-spacing: .08em;
    text-transform: uppercase; padding: 2px 7px; border-radius: 20px;
    background: var(--accent); color: var(--surface);
  }
  @media (prefers-color-scheme: dark) { .cmp-badge { color: #111513; } }
  .cmp-units { font-size: 12.5px; color: var(--ink-2); margin-top: 5px !important; }
  .cmp-units b { color: var(--ink); font-family: var(--mono); font-weight: 500; }
  .cmp-split { font-size: 11.5px; color: var(--ink-3); margin-top: 2px !important; }
  .cmp-price { text-align: right; white-space: nowrap; }
  .cmp-price .m {
    font-family: var(--mono); font-size: 22px; font-weight: 500;
    letter-spacing: -.02em; display: block; font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .cmp-price .y { font-size: 11.5px; color: var(--ink-3); font-family: var(--mono); }
  .cmp-price .tier { font-size: 10.5px; color: var(--ink-3); display: block; margin-top: 3px; font-family: var(--mono); }
  .cmp-free {
    grid-column: 1 / -1; font-size: 12px; padding: 7px 10px; border-radius: 5px;
    display: flex; gap: 7px; align-items: flex-start;
  }
  .cmp-free.no { background: var(--warn-soft); color: var(--warn); }
  .cmp-free.yes { background: var(--accent-soft); color: var(--ink-2); }

  .cmp-chartbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .cmp-legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink-2); }
  .cmp-legend span { display: flex; align-items: center; gap: 6px; }
  .cmp-ghost {
    font-family: var(--sans); font-size: 12px; font-weight: 500; color: var(--ink-2); cursor: pointer;
    background: var(--surface-2); border: 1px solid var(--rule); border-radius: 5px; padding: 5px 10px;
  }
  .cmp-plotwrap { position: relative; overflow-x: auto; }
  .cmp-plot { display: block; width: 100%; min-width: 520px; height: auto; }
  .cmp-tip {
    position: absolute; pointer-events: none; opacity: 0; transition: opacity .1s;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 6px;
    padding: 9px 11px; font-size: 12px; box-shadow: var(--cmp-shadow); min-width: 155px; z-index: 3;
  }
  .cmp-tip .th { font-weight: 600; margin-bottom: 5px; color: var(--ink); }
  .cmp-tip .tr { display: flex; justify-content: space-between; gap: 14px; color: var(--ink-2); }
  .cmp-tip .tr b { color: var(--ink); font-family: var(--mono); font-weight: 500; }
  .cmp-tablewrap { overflow-x: auto; }
  .cmp-caption { font-size: 11.5px; color: var(--ink-3); margin-top: 10px !important; font-family: var(--mono); }

  @media (prefers-reduced-motion: reduce) { .cmp * { transition: none !important; } }
</style>

<script is:inline>
(function () {
  "use strict";
  var USD = 0.8743;

  /* Paliers — [capacité, prix/mois en annuel, prix/mois en mensuel, plan?] */
  var LADDERS = {
    zapier: { cur: 1, name: "Professional", t: [
      [750, 17.85, 26.77], [1500, 34.82, 52.22], [2000, 43.74, 65.61],
      [5000, 79.45, 119.18], [10000, 115.16, 172.74], [20000, 168.72, 253.08],
      [50000, 257.99, 386.99], [100000, 436.54, 654.80], [200000, 686.49, 1025.72]] },
    make: { cur: USD, name: "Core", t: [
      [10000, 9, 10.59], [20000, 16, 18.82], [40000, 29, 34.12],
      [80000, 55, 64.71], [150000, 99, 116.47], [300000, 182.16, 214.31]],
      up: { name: "Pro", t: [
      [500000, 410.27, 482.67], [750000, 576.94, 678.75],
      [1000000, 748.73, 880.86], [1500000, 1078.18, 1268.44]] } },
    n8n: { cur: 1, name: "Cloud", t: [
      [2500, 20, 24, "Starter"], [10000, 50, 60, "Pro"], [50000, 120, 144, "Pro"],
      [40000, 667, 800, "Business"], [75000, 1213, 1456, "Business"],
      [100000, 1438, 1726, "Business"], [150000, 1824, 2189, "Business"],
      [200000, 2199, 2639, "Business"]] }
  };
  var META = {
    zapier: { label: "Zapier", unit: "tâches", v: "--cmp-s1" },
    make:   { label: "Make",   unit: "opérations", v: "--cmp-s2" },
    n8n:    { label: "n8n",    unit: "exécutions", v: "--cmp-s3" }
  };
  var ANNUAL = true;

  function cheapest(key, need) {
    var L = LADDERS[key];
    var pick = function (r) { return ANNUAL ? r[1] : r[2]; };
    var all = L.t.map(function (r) { return [r[0], pick(r), r[3] || L.name]; });
    if (L.up) all = all.concat(L.up.t.map(function (r) { return [r[0], pick(r), r[3] || L.up.name]; }));
    var best = null;
    all.forEach(function (row) {
      if (need <= row[0] && (best === null || row[1] < best.p)) best = { p: row[1], cap: row[0], plan: row[2] };
    });
    return best ? { eur: best.p * L.cur, cap: best.cap, plan: best.plan } : null;
  }

  function nf(n) { return n.toLocaleString("fr-FR"); }
  function ef(n) { return n.toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €"; }
  function e0(n) { return Math.round(n).toLocaleString("fr-FR") + " €"; }
  function $(id) { return document.getElementById(id); }

  function state() {
    return {
      events: Math.max(1, Math.min(200000, +$("cmpEvents").value || 1)),
      actions: Math.max(1, Math.min(30, +$("cmpActions").value || 1)),
      plumb: Math.max(0, Math.min(30, +$("cmpPlumb").value || 0)),
      poll: $("cmpPoll").getAttribute("aria-pressed") === "true",
      iv: +$("cmpIv").value
    };
  }

  function model(st) {
    var cycles = st.poll ? Math.round(1440 / st.iv) * 30 : 0;
    var per = st.actions + st.plumb;
    // Make ne regroupe pas : chaque événement paie son déclencheur, en
    // interrogation comme en webhook (mesuré : paquets de 10 = 10 passages à 4 op.).
    // L'interrogation ajoute seulement les vérifications qui ne trouvent rien.
    var idle = st.poll ? Math.max(0, cycles - st.events) : 0;
    return {
      cycles: cycles,
      zapier: { units: st.events * st.actions, fixed: 0 },
      make: { units: idle + st.events * (1 + per), fixed: idle },
      n8n: { units: st.poll ? Math.min(st.events, cycles) : st.events, fixed: 0 }
    };
  }

  function freeVerdict(key, st, m) {
    if (key === "zapier") {
      var steps = 1 + st.actions + st.plumb;
      if (steps > 2) return { ok: false, txt: "Palier gratuit exclu : il plafonne les scénarios à 2 étapes, le tien en compte " + steps + "." };
      if (m.zapier.units > 100) return { ok: false, txt: "Palier gratuit dépassé : 100 tâches offertes, " + nf(m.zapier.units) + " nécessaires." };
      return { ok: true, txt: "Palier gratuit suffisant : " + nf(m.zapier.units) + " tâches sur les 100 offertes." };
    }
    if (key === "make") {
      if (m.make.units > 1000) {
        return { ok: false, txt: (st.poll && m.make.fixed >= 1000)
          ? "La veille seule consomme " + nf(m.make.fixed) + " opérations par mois, pour 1 000 offertes. Dépassé avant le premier déclenchement."
          : "Palier gratuit dépassé : 1 000 opérations offertes, " + nf(m.make.units) + " nécessaires." };
      }
      return { ok: true, txt: "Palier gratuit suffisant : " + nf(m.make.units) + " opérations sur les 1 000 offertes." };
    }
    return { ok: false, txt: "Aucun palier gratuit sur le cloud n8n — essai limité dans le temps uniquement." };
  }

  function render() {
    var st = state(), m = model(st);

    $("cmpCyclesHint").textContent = st.poll
      ? nf(Math.round(1440 / st.iv)) + " vérifications par jour, soit " + nf(m.cycles) + " par mois. Chacune coûte une opération chez Make, même à vide."
      : "";
    $("cmpIvField").hidden = !st.poll;
    $("cmpModeHint").textContent = st.poll
      ? "L'outil vérifie la source à intervalle fixe. C'est le mode imposé quand la source ne sait pas prévenir : une feuille de calcul, une boîte mail, un dossier."
      : "La source prévient l'outil dès qu'un événement survient (webhook). Rien ne tourne entre deux événements.";

    var keys = ["zapier", "make", "n8n"];
    var rows = keys.map(function (k) {
      return { k: k, units: m[k].units, fixed: m[k].fixed, price: cheapest(k, m[k].units) };
    });
    var priced = rows.filter(function (r) { return r.price; });
    var min = priced.length ? Math.min.apply(null, priced.map(function (r) { return r.price.eur; })) : null;

    $("cmpTools").innerHTML = rows.map(function (r) {
      var M = META[r.k], f = freeVerdict(r.k, st, m);
      var win = r.price && min !== null && r.price.eur === min;
      var price = r.price
        ? '<span class="m">' + ef(r.price.eur) + '</span><span class="y">' + e0(r.price.eur * 12) +
          ' / an</span><span class="tier">' + r.price.plan + ' · palier ' + nf(r.price.cap) + '</span>'
        : '<span class="m">—</span><span class="tier">au-delà de la grille publiée</span>';
      var split = r.fixed > 0
        ? 'dont <b>' + nf(r.fixed) + '</b> de veille à vide (' + Math.round(r.fixed / r.units * 100) + ' %)'
        : (r.k === "make" ? "aucune consommation entre deux événements" : "");
      return '<div class="cmp-tool" style="--sc:var(' + M.v + ')">' +
        '<div><div class="cmp-name"><i class="cmp-dot"></i><strong>' + M.label + '</strong>' +
        (win ? '<span class="cmp-badge">moins cher</span>' : '') + '</div>' +
        '<p class="cmp-units"><b>' + nf(r.units) + '</b> ' + M.unit + ' / mois</p>' +
        (split ? '<p class="cmp-split">' + split + '</p>' : '') + '</div>' +
        '<div class="cmp-price">' + price + '</div>' +
        '<div class="cmp-free ' + (f.ok ? 'yes' : 'no') + '">' + (f.ok ? '✓' : '✕') + '<span>' + f.txt + '</span></div>' +
        '</div>';
    }).join("");

    var winner = priced.filter(function (r) { return r.price.eur === min; })[0];
    $("cmpVTitle").textContent = winner
      ? META[winner.k].label + " est le moins cher pour ce scénario"
      : "Volume au-delà des grilles publiées";
    $("cmpVBody").textContent = st.poll
      ? (m.make.fixed > 0
        ? "Chez Make, " + nf(m.make.fixed) + " vérifications par mois ne trouvent rien et sont facturées quand même : si ta source sait prévenir, le mode Instantané les supprime. Chez n8n, garde l'interrogation : elle regroupe les événements d'un même cycle."
        : "Au moins un événement par cycle : Make n'a plus de vérification à vide, l'Instantané ne changerait rien pour lui. Chez n8n, l'interrogation regroupe tes événements et plafonne la facture à " + nf(m.cycles) + " exécutions.")
      : "En instantané, rien ne tourne entre deux événements : Make n'a plus de veille à payer, c'est son mode le plus économique. n8n, lui, perd le regroupement : chaque événement devient une exécution.";

    drawChart(st);
  }

  /* ---------- courbes ---------- */
  var XMIN = 50, XMAX = 50000, W = 760, H = 340;
  var PAD = { t: 18, r: 76, b: 44, l: 56 };
  var TICKS = [50, 100, 250, 500, 1000, 2500, 5000, 10000, 25000, 50000];
  var CURVE = [];
  function pxOf(v) {
    return PAD.l + (Math.log10(v) - Math.log10(XMIN)) / (Math.log10(XMAX) - Math.log10(XMIN)) * (W - PAD.l - PAD.r);
  }

  function drawChart(st) {
    var N = 70, i;
    CURVE = [];
    for (i = 0; i < N; i++) {
      var v = Math.round(XMIN * Math.pow(XMAX / XMIN, i / (N - 1)));
      var s2 = { events: v, actions: st.actions, plumb: st.plumb, poll: st.poll, iv: st.iv };
      var m = model(s2);
      var z = cheapest("zapier", m.zapier.units), mk = cheapest("make", m.make.units), n = cheapest("n8n", m.n8n.units);
      CURVE.push({ v: v, zapier: z ? z.eur : null, make: mk ? mk.eur : null, n8n: n ? n.eur : null });
    }
    var vals = [];
    CURVE.forEach(function (p) { ["zapier", "make", "n8n"].forEach(function (k) { if (p[k] != null) vals.push(p[k]); }); });
    var ymax = Math.max(20, Math.ceil(Math.max.apply(null, vals) / 50) * 50);
    var py = function (v) { return H - PAD.b - (v / ymax) * (H - PAD.t - PAD.b); };

    var s = "";
    for (i = 0; i <= 4; i++) {
      var yv = Math.round(ymax / 4 * i);
      s += '<line x1="' + PAD.l + '" y1="' + py(yv) + '" x2="' + (W - PAD.r) + '" y2="' + py(yv) + '" stroke="var(--cmp-grid)" stroke-width="1"/>';
      s += '<text x="' + (PAD.l - 9) + '" y="' + (py(yv) + 4) + '" text-anchor="end" font-size="11" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace">' + nf(yv) + '</text>';
    }
    s += '<text x="' + (PAD.l - 9) + '" y="' + (PAD.t - 5) + '" text-anchor="end" font-size="10" fill="var(--ink-3)" font-family="Archivo, sans-serif">€/mois</text>';
    TICKS.forEach(function (v) {
      s += '<line x1="' + pxOf(v) + '" y1="' + (H - PAD.b) + '" x2="' + pxOf(v) + '" y2="' + (H - PAD.b + 4) + '" stroke="var(--rule)" stroke-width="1"/>';
      s += '<text x="' + pxOf(v) + '" y="' + (H - PAD.b + 18) + '" text-anchor="middle" font-size="11" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace">' + (v >= 1000 ? (v / 1000) + "k" : v) + '</text>';
    });
    s += '<text x="' + ((PAD.l + W - PAD.r) / 2) + '" y="' + (H - 6) + '" text-anchor="middle" font-size="10" fill="var(--ink-3)" font-family="Archivo, sans-serif">DÉCLENCHEMENTS PAR MOIS</text>';
    s += '<line x1="' + PAD.l + '" y1="' + (H - PAD.b) + '" x2="' + (W - PAD.r) + '" y2="' + (H - PAD.b) + '" stroke="var(--rule)" stroke-width="1"/>';

    ["zapier", "make", "n8n"].forEach(function (k) {
      var col = "var(" + META[k].v + ")", segs = [], cur = [];
      CURVE.forEach(function (p) {
        if (p[k] == null) { if (cur.length) segs.push(cur); cur = []; }
        else cur.push(pxOf(p.v).toFixed(1) + "," + py(p[k]).toFixed(1));
      });
      if (cur.length) segs.push(cur);
      segs.forEach(function (pts) {
        s += '<polyline points="' + pts.join(" ") + '" fill="none" stroke="' + col + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>';
      });
      var last = null;
      CURVE.forEach(function (p) { if (p[k] != null) last = p; });
      if (last) {
        s += '<circle cx="' + pxOf(last.v) + '" cy="' + py(last[k]) + '" r="3.5" fill="' + col + '" stroke="var(--surface)" stroke-width="2"/>';
        s += '<text x="' + (pxOf(last.v) + 9) + '" y="' + (py(last[k]) + 4) + '" font-size="11.5" font-weight="600" fill="' + col + '" font-family="Archivo, sans-serif">' + META[k].label + '</text>';
      }
    });
    s += '<line id="cmpCross" x1="0" y1="' + PAD.t + '" x2="0" y2="' + (H - PAD.b) + '" stroke="var(--ink-3)" stroke-width="1" opacity="0"/>';
    $("cmpPlot").innerHTML = s;

    var tb = $("cmpTbl").querySelector("tbody");
    tb.innerHTML = TICKS.map(function (v) {
      var m2 = model({ events: v, actions: st.actions, plumb: st.plumb, poll: st.poll, iv: st.iv });
      var c = function (k) { var r = cheapest(k, m2[k].units); return r ? ef(r.eur) : "hors grille"; };
      return "<tr><td>" + nf(v) + "</td><td>" + c("zapier") + "</td><td>" + c("make") + "</td><td>" + c("n8n") + "</td></tr>";
    }).join("");
  }

  function hover(ev) {
    var plot = $("cmpPlot"), tip = $("cmpTip"), cross = plot.querySelector("#cmpCross");
    if (!cross || !CURVE.length) return;
    var r = plot.getBoundingClientRect();
    var sx = (ev.clientX - r.left) / r.width * W;
    var best = CURVE[0], bd = Infinity;
    CURVE.forEach(function (p) { var d = Math.abs(pxOf(p.v) - sx); if (d < bd) { bd = d; best = p; } });
    cross.setAttribute("x1", pxOf(best.v)); cross.setAttribute("x2", pxOf(best.v));
    cross.setAttribute("opacity", "1");
    tip.innerHTML = '<div class="th">' + nf(best.v) + ' déclenchements / mois</div>' +
      ["zapier", "make", "n8n"].map(function (k) {
        return '<div class="tr"><span>' + META[k].label + '</span><b>' + (best[k] != null ? ef(best[k]) : "hors grille") + '</b></div>';
      }).join("");
    tip.style.opacity = "1";
    var lx = pxOf(best.v) / W * r.width;
    tip.style.left = Math.max(4, Math.min(r.width - 175, lx + 14)) + "px";
    tip.style.top = "14px";
  }

  function init() {
    var evIn = $("cmpEvents"), evR = $("cmpEventsR");
    var R2V = function (p) { return Math.round(XMIN * Math.pow(200000 / XMIN, p / 100)); };
    var V2R = function (v) { return Math.round(Math.log10(Math.max(XMIN, v) / XMIN) / Math.log10(200000 / XMIN) * 100); };
    evR.value = V2R(+evIn.value);
    evR.addEventListener("input", function () { evIn.value = R2V(+evR.value); render(); });
    evIn.addEventListener("input", function () { evR.value = V2R(+evIn.value); render(); });
    ["cmpActions", "cmpPlumb", "cmpIv"].forEach(function (id) { $(id).addEventListener("input", render); });

    var mp = $("cmpPoll"), mh = $("cmpHook");
    mp.addEventListener("click", function () { mp.setAttribute("aria-pressed", "true"); mh.setAttribute("aria-pressed", "false"); render(); });
    mh.addEventListener("click", function () { mp.setAttribute("aria-pressed", "false"); mh.setAttribute("aria-pressed", "true"); render(); });

    var by = $("cmpYear"), bm = $("cmpMonth");
    by.addEventListener("click", function () { ANNUAL = true; by.setAttribute("aria-pressed", "true"); bm.setAttribute("aria-pressed", "false"); render(); });
    bm.addEventListener("click", function () { ANNUAL = false; by.setAttribute("aria-pressed", "false"); bm.setAttribute("aria-pressed", "true"); render(); });

    var tt = $("cmpTToggle"), tw = $("cmpTWrap");
    tt.addEventListener("click", function () {
      var open = tw.hidden;
      tw.hidden = !open;
      tt.setAttribute("aria-expanded", String(open));
      tt.textContent = open ? "Masquer les valeurs" : "Voir les valeurs";
    });

    var plot = $("cmpPlot"), tip = $("cmpTip");
    plot.addEventListener("pointermove", hover);
    plot.addEventListener("pointerleave", function () {
      tip.style.opacity = "0";
      var c = plot.querySelector("#cmpCross");
      if (c) c.setAttribute("opacity", "0");
    });
    window.addEventListener("resize", function () { drawChart(state()); });
    render();
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
})();
</script>
