---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  videoId?: string;
  youtubeTitle?: string;
  series: 'A' | 'B';
  format?: 'Comparatif' | 'Tuto' | 'Avis' | 'Problème→solution';
  containsAffiliateLinks: boolean;
  relatedSlugs: string[];
  ogImage?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  videoId,
  youtubeTitle,
  series,
  format,
  containsAffiliateLinks,
  relatedSlugs,
  ogImage,
  headings = [],
} = Astro.props;

// Sommaire : les H2 de l'article, affiché seulement s'il y a de quoi naviguer.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Résout les articles liés (maillage interne) à partir de leurs slugs.
const related = (
  await Promise.all(relatedSlugs.map((slug) => getEntry('articles', slug)))
).filter((entry) => entry !== undefined);

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Johan', url: 'https://le-levier.fr/a-propos' },
  publisher: { '@type': 'Organization', name: 'Le Levier' },
};

if (videoId) {
  articleSchema.video = {
    '@type': 'VideoObject',
    name: youtubeTitle ?? title,
    description,
    thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
    uploadDate: pubDate.toISOString(),
    embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  };
}
---
<BaseLayout title={`${title} — Le Levier`} description={description} ogImage={ogImage} structuredData={articleSchema}>
  <div class="wrap article-page">
    <div class="article-grid">
    {showToc && (
      <aside class="toc-side" aria-label="Sommaire">
        <p class="toc-title">Sommaire</p>
        <ol class="toc-list">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </aside>
    )}
    <div class="col">
      <p class="breadcrumb">
        <a href="/">Accueil</a> / <a href="/articles">Articles</a> / <span>{title}</span>
      </p>

      {containsAffiliateLinks && (
        <div class="disclosure">
          <strong>Publicité — liens affiliés.</strong> Cet article contient des liens vers des produits que j'utilise réellement. S'ils débouchent sur un abonnement, je touche une commission, sans coût supplémentaire pour toi. Détail complet sur <a href="/comment-je-suis-remunere">comment je suis rémunéré</a>.
        </div>
      )}

      <div class="article-meta">
        <span>{format ?? 'Article'}</span>
        <span>Série {series === 'A' ? 'A — piloter sa boîte' : 'B — investisseur'}</span>
        <span>Publié le {dateFormatter.format(pubDate)}</span>
        {updatedDate && <span>Mis à jour le {dateFormatter.format(updatedDate)}</span>}
      </div>

      <h1>{title}</h1>

      {videoId && <YouTubeFacade videoId={videoId} title={youtubeTitle ?? title} />}

      {showToc && (
        <details class="toc-mobile">
          <summary>Sommaire</summary>
          <ol class="toc-list">
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </details>
      )}

      <article class="body-content">
        <slot />
      </article>

      {related.length > 0 && (
        <div class="related">
          <h2>Pour aller plus loin</h2>
          <ul class="body">
            {related.map((entry) => entry && (
              <li><a href={`/articles/${entry.slug}`}>{entry.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Sommaire latéral : surligne la section en cours de lecture, et s'efface
  // quand un élément pleine largeur (le comparateur) passe dessous.
  const side = document.querySelector<HTMLElement>('.toc-side');
  if (side) {
    const links = new Map(
      [...side.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const sections = [...document.querySelectorAll<HTMLElement>('article.body-content h2[id]')];
    const setActive = () => {
      let current = sections[0];
      for (const h of sections) if (h.getBoundingClientRect().top < window.innerHeight * 0.3) current = h;
      // en bas de page, les dernières sections ne remontent jamais assez haut
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) current = sections[sections.length - 1];
      links.forEach((a, id) => a.toggleAttribute('aria-current', id === current?.id));
    };
    const wide = [...document.querySelectorAll<HTMLElement>('.cmp')];
    const update = () => {
      setActive();
      const t = side.getBoundingClientRect();
      const overlaps = wide.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < t.bottom && r.bottom > t.top;
      });
      side.classList.toggle('is-hidden', overlaps);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Sommaire mobile : se referme quand on choisit une section.
  document.querySelectorAll<HTMLDetailsElement>('.toc-mobile').forEach((d) => {
    d.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) d.open = false;
    });
  });
</script>
