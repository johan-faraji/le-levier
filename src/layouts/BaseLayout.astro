---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Layout de base : c'est ICI que se joue le contrôle SEO de chaque page
// (title, description, canonical, Open Graph, données structurées).
// Toutes les pages du site passent par ce layout, directement ou via
// ArticleLayout qui l'enrobe.
interface Props {
  title: string;            // devient <title> — 50 à 60 caractères idéalement
  description: string;      // devient <meta name="description"> — 120 à 160 caractères
  ogImage?: string;         // image de partage, chemin absolu ou relatif au site
  noindex?: boolean;        // true pour exclure une page des moteurs de recherche
  structuredData?: object;  // JSON-LD additionnel (ex : schéma Article)
}

const {
  title,
  description,
  ogImage = '/og-default.svg',
  noindex = false,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Le Levier',
  url: 'https://le-levier.fr',
  description: 'Piloter sa boîte avec de la data, sans coder.',
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph / partage réseaux sociaux -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Le Levier" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Polices — mêmes choix que les documents de plan, pour la cohérence -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
  />

  <!-- Fil RSS -->
  <link rel="alternate" type="application/rss+xml" title="Le Levier" href="/rss.xml" />

  <!-- Données structurées -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
